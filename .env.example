# Copia este archivo como .env.local y llena tus valores.
# .env.local NO se sube a git (está en .gitignore) ni se comparte.

# --- Firebase (Consola de Firebase → Configuración del proyecto → Tus apps) ---
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:aaaaaaaaaaaaaaaaaaaaaa

# --- Cloudinary (fotos de perfil de los técnicos) ---
# Usa un "upload preset" unsigned limitado a la carpeta tech_photos y a imágenes.
VITE_CLOUDINARY_CLOUD=your_cloud_name
VITE_CLOUDINARY_PRESET=your_unsigned_preset

# --- PayPal (opcional) ---
# Si no se configuran, la opción PayPal no aparece en el modal de pago.
# PayPal no acepta pesos colombianos: el monto se convierte a USD con esta tasa.
VITE_PAYPAL_BUSINESS_ID=
VITE_COP_PER_USD=
